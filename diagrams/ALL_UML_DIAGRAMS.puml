================================================================================
  BANKITIS ONLINE BANKING SYSTEM - UML & ARCHITECTURE SPECIFICATIONS
  COMPATIBLE WITH: StarUML, Rational Rose, Visual Paradigm, PlantUML, PlantText
================================================================================
'/

' ------------------------------------------------------------------------------
' 1. UML CLASS DIAGRAM
' ------------------------------------------------------------------------------
@startuml ClassDiagram
title Bankitis Online Banking System - UML Class Diagram

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 10
skinparam shadowing true

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  SUSPENDED
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

enum TransactionCategory {
  TRANSFER
  RENT
  GROCERIES
  UTILITIES
  DINING
  ENTERTAINMENT
  SALARY
  OTHER
}

class User {
  - id: String
  + fullName: String
  + email: String
  + phoneNumber: String
  - passwordHash: String
  + role: Role
  + createdAt: DateTime
  + updatedAt: DateTime
  --
  + register(data: UserRegisterDTO): User
  + login(credentials: CredentialsDTO): SessionToken
  + resetPassword(newPass: String): Boolean
}

class Account {
  - id: String
  + accountNumber: String
  + upiId: String
  - upiPinHash: String
  + failedPinCount: Integer
  + pinLockedUntil: DateTime
  + balance: Decimal
  + status: AccountStatus
  - userId: String
  --
  + checkBalance(amount: Decimal): Boolean
  + verifyPin(inputPin: String): Boolean
  + lockPin(lockoutDuration: Integer): Void
  + unlockPin(): Void
  + updateBalance(amountDelta: Decimal): Decimal
}

class Beneficiary {
  - id: String
  + nickname: String
  + beneficiaryUpi: String
  + beneficiaryName: String
  - ownerId: String
  + createdAt: DateTime
  --
  + validateRecipient(): Boolean
  + saveBeneficiary(): Beneficiary
  + deleteBeneficiary(): Boolean
}

class Transaction {
  - id: String
  + referenceNumber: String
  + idempotencyKey: String
  + amount: Decimal
  + fee: Decimal
  + status: TransactionStatus
  + category: TransactionCategory
  + note: String
  - senderAccountId: String
  - receiverAccountId: String
  + senderBalanceAfter: Decimal
  + receiverBalanceAfter: Decimal
  + createdAt: DateTime
  --
  + executeAtomicTransfer(): TransferReceipt
  + generateReferenceNumber(): String
}

class Notification {
  - id: String
  + title: String
  + message: String
  + type: String
  + isRead: Boolean
  - userId: String
  + createdAt: DateTime
  --
  + markAsRead(): Void
  + sendEmailAlert(): Void
}

class AuditLog {
  - id: String
  + action: String
  + ipAddress: String
  + userAgent: String
  + details: Json
  - userId: String
  + createdAt: DateTime
  --
  + logEvent(action: String, details: Json): Void
}

User "1" *-- "1..*" Account : owns
User "1" *-- "0..*" Beneficiary : manages
User "1" *-- "0..*" Notification : receives
User "1" *-- "0..*" AuditLog : triggers

Account "1" <-- "0..*" Transaction : debitAccount (sender)
Account "1" <-- "0..*" Transaction : creditAccount (receiver)

User ..> Role
Account ..> AccountStatus
Transaction ..> TransactionStatus
Transaction ..> TransactionCategory

@enduml

' ------------------------------------------------------------------------------
' 2. UML ACTIVITY DIAGRAM (MONEY TRANSFER FLOW)
' ------------------------------------------------------------------------------
@startuml ActivityDiagram
title Bankitis Online Banking System - UML Activity Diagram

skinparam monochrome false
skinparam roundcorner 10
skinparam shadowing true

start

:Customer opens Money Transfer module;
:Enter Recipient UPI ID (or select from Beneficiaries);

:System queries database to resolve UPI ID;

if (Recipient UPI exists and account is active?) then (No)
  #Pink:Display error: "UPI ID does not resolve to an active account";
  stop
else (Yes)
  if (Recipient is same as Sender account?) then (Yes)
    #Pink:Display error: "Self-transfer is not permitted";
    stop
  else (No)
    :Display verified recipient's full name (Question 42);
  endif
endif

:Customer enters Transfer Amount (INR), Category, and Note;

if (Amount >= 1.00 and Amount <= 100,000.00?) then (No)
  #Pink:Display error: "Amount violates transaction bounds (₹1 - ₹1,00,000)";
  stop
else (Yes)
endif

if (Amount + Today's Utilized <= 200,000.00?) then (No)
  #Pink:Display error: "Daily transfer ceiling of ₹2,00,000 exceeded";
  stop
else (Yes)
endif

if (Available Account Balance >= Transfer Amount?) then (No)
  #Pink:Display error: "Insufficient account balance";
  stop
else (Yes)
endif

:Customer enters 6-Digit UPI / Transaction PIN;

if (Is account currently in 15-minute PIN lockout?) then (Yes)
  #Pink:Display error: "Account temporarily locked due to repeated PIN failures";
  stop
else (No)
endif

if (Verify 6-digit PIN with bcrypt hash?) then (Invalid PIN)
  :Increment failed PIN counter;
  if (Failed counter >= 3?) then (Yes)
    :Set pinLockedUntil to Current Time + 15 minutes;
    :Log SECURITY_LOCKOUT event to AuditLog;
    #Pink:Display error: "Account locked for 15 minutes due to 3 failed attempts";
    stop
  else (No)
    #Pink:Display error: "Incorrect UPI PIN entered";
    stop
  endif
else (Valid PIN)
  :Reset failed PIN counter to 0;
endif

partition "PostgreSQL ACID Transaction Block" {
  :Sort sender and receiver account IDs deterministically;
  :Acquire Row-Level Lock: SELECT id FROM Account WHERE id IN (...) FOR UPDATE;
  :Re-verify sender balance under locked row;
  :Update sender balance: balance = balance - amount;
  :Update receiver balance: balance = balance + amount;
  :Generate unique reference: TXN-YYYYMMDD-XXXXXX;
  :Insert Transaction ledger row (status: COMPLETED);
  :Insert AuditLog entry for transfer execution;
  :Commit ACID transaction to disk;
}

fork
  :Generate in-app DEBIT notification for sender;
fork again
  :Generate in-app CREDIT notification for receiver;
fork again
  :Dispatch transactional email alert;
end fork

:Display Payment Success Receipt with Reference ID;
:Update available balance on Dashboard;

stop
@enduml

' ------------------------------------------------------------------------------
' 3. SYSTEM ARCHITECTURE DIAGRAM (3-TIER MODEL)
' ------------------------------------------------------------------------------
@startuml SystemArchitecture
title Bankitis Online Banking System - 3-Tier Enterprise System Architecture

skinparam componentStyle rectangle
skinparam roundcorner 10
skinparam shadowing true

package "Tier 1: Presentation Layer (Browser Client / Cloudflare Pages)" #AliceBlue {
  [Customer Dashboard UI] as ClientDash
  [Send Money (UPI Flow) UI] as ClientTransfer
  [Beneficiary & Directory UI] as ClientBeneficiary
  [Statement Exporters (PDF/CSV)] as ClientExport
  [Executive Bank Admin Console (/admin)] as AdminConsole
}

package "Tier 2: Business Logic & Application Layer (Banking Engine)" #LightCyan {
  [Authentication & Session Guard] as AuthModule
  [Atomic Transfer Controller] as TransferController
  [Core Banking Engine (Limits & Verification)] as BankingEngine
  [Admin Services (Freeze & Adjustments)] as AdminService
  [6-Digit PIN Security Validator] as PinValidator
  [Notification & Alert Center] as NotifService
}

package "Tier 3: Data & Persistence Layer (Cloud PostgreSQL / Supabase)" #Lavender {
  database "PostgreSQL Database (Supabase Cloud)" as Postgres {
    folder "Relational Tables" {
      [public.users]
      [public.accounts]
      [public.transactions]
      [public.beneficiaries]
      [public.notifications]
      [public.audit_logs]
    }
  }
  [Local Persistence Engine (HTML5 Storage)] as LocalStorage
}

ClientDash --> AuthModule : User Interaction
ClientTransfer --> TransferController : Submit Payment
ClientBeneficiary --> BankingEngine : Directory Lookup
ClientExport --> BankingEngine : Export Statement
AdminConsole --> AdminService : Role: ADMIN

TransferController --> PinValidator : Validate 6-Digit PIN
TransferController --> BankingEngine : Verify Balances & Limits
BankingEngine --> Postgres : Live SQL / Cloud API
BankingEngine --> LocalStorage : Atomic Commit
AdminService --> Postgres : Live Status Update
BankingEngine --> NotifService : Emit Transfer Events

@enduml

